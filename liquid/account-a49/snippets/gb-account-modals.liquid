</div>

{%- comment -%} Product locked — cannot reduce to zero {%- endcomment -%}
<div class="gb-acct-modal gb-acct-modal--sheet" data-acct-modal-panel="product-locked" role="dialog" aria-modal="true" aria-labelledby="acct-modal-product-locked" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-product-locked">Edit Product</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__alert"><svg xmlns="http://www.w3.org/2000/svg" viewBox="17 249 20 20" fill="none" aria-hidden="true"><path d="M26.9964 267.366C31.5988 267.366 35.3298 263.635 35.3298 259.033C35.3298 254.43 31.5988 250.699 26.9964 250.699C22.394 250.699 18.6631 254.43 18.6631 259.033C18.6631 263.635 22.394 267.366 26.9964 267.366Z" fill="#DD655E"/><path d="M29.4971 256.535L24.4971 261.535M24.4971 256.535L29.4971 261.535" stroke="#ffffff" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p>Sorry! <span>Subscriptions need to have at least one product. You need to add another product in order to delete this one.</span></p>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-prod-grid">
        <div class="gb-acct-prod" data-acct-product data-acct-qty-min="1">
          <img class="gb-acct-prod__thumb" src="{{ 'product-placeholder.png' | asset_url }}" width="400" height="400" alt="Superfood Greens Gummies" loading="lazy" decoding="async">
          <div class="gb-acct-prod__info">
            <p class="gb-acct-prod__name">Superfood Greens Gummies</p>
            <p class="gb-acct-prod__price"><span class="gb-acct-prod__now">$121.50</span><span class="gb-acct-prod__was">$168.90</span></p>
          </div>
          <div class="gb-acct-prod__opts">
            <div class="gb-acct-prod__opt">
              <span class="gb-acct-prod__opt-label">Flavour</span>
              <div class="gb-acct-field__control gb-acct-prod__control"><select class="gb-acct-field__input gb-acct-prod__select" data-acct-field data-select><option selected>Flavour</option><option>Flavour option 1</option><option>Flavour option 2</option><option>Flavour option 3</option></select></div>
            </div>
          </div>
          <div class="gb-acct-qty">
            <button class="gb-acct-qty__btn gb-acct-qty__btn--down" type="button" data-acct-qty="down" aria-label="Decrease quantity" disabled><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7H13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
            <input class="gb-acct-qty__value" type="number" inputmode="numeric" min="0" step="1" value="1" data-acct-qty-value aria-label="Quantity">
            <button class="gb-acct-qty__btn gb-acct-qty__btn--up" type="button" data-acct-qty="up" aria-label="Increase quantity"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1.167V12.833M1.167 7H12.833" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close data-acct-label-default="Save" disabled>Save</button>
    </div>
  </div>
</div>
