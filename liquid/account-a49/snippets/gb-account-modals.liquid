{%- comment -%} Shipping address — current selection {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="shipping-current" role="dialog" aria-modal="true" aria-labelledby="acct-modal-shipping-current" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-shipping-current">Edit Shipping Address</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-addr">
        <p class="gb-acct-addr__title">Current Address</p>
        <div class="gb-acct-addr__card">
          <label class="gb-acct-addr__pick" for="acct-addr-1">
            <input class="gb-acct-addr__radio" id="acct-addr-1" type="radio" name="acct-shipping" value="current" checked data-acct-field>
            <span class="gb-acct-addr__lines">
              <span class="gb-acct-addr__group">
                <span class="gb-acct-addr__line gb-acct-addr__line--name">{{ customer.default_address.name | default: customer.name | escape }}</span>
                {%- if customer.default_address.address1 != blank -%}<span class="gb-acct-addr__line">{{ customer.default_address.address1 | escape }}</span>{%- endif -%}
                {%- if customer.default_address.address2 != blank -%}<span class="gb-acct-addr__line">{{ customer.default_address.address2 | escape }}</span>{%- endif -%}
                <span class="gb-acct-addr__line">{{ customer.default_address.city | escape }}, {{ customer.default_address.province | escape }}, {{ customer.default_address.country | escape }}</span>
                <span class="gb-acct-addr__line">{{ customer.default_address.zip | escape }}</span>
              </span>
            </span>
          </label>
          <button class="gb-acct-link" type="button" data-acct-modal="shipping-form">Edit</button>
        </div>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close disabled>Save</button>
    </div>
  </div>
</div>

{%- comment -%} Shipping address — edit form (submits, next → success) {%- endcomment -%}
<div class="gb-acct-modal gb-acct-modal--sheet" data-acct-modal-panel="shipping-form" role="dialog" aria-modal="true" aria-labelledby="acct-modal-shipping-form" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <form class="gb-acct-modal__panel" tabindex="-1" data-acct-modal-next="shipping-success">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-shipping-form">Edit Shipping Address</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-form">
        <div class="gb-acct-form__row">
          <div class="gb-acct-field">
            <label class="gb-acct-field__label" for="acct-sh-first">First Name*</label>
            <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-first" name="first-name" type="text" value="{{ customer.default_address.first_name | escape }}" required autocomplete="given-name" data-acct-field></div>
          </div>
          <div class="gb-acct-field">
            <label class="gb-acct-field__label" for="acct-sh-last">Last Name*</label>
            <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-last" name="last-name" type="text" value="{{ customer.default_address.last_name | escape }}" required autocomplete="family-name" data-acct-field></div>
          </div>
        </div>
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-sh-phone">Phone number*</label>
          <div class="gb-acct-field__box"><span class="gb-acct-field__prefix">+61</span><input class="gb-acct-field__bare" id="acct-sh-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="000 000 000" value="{{ customer.default_address.phone | escape }}" required data-acct-field></div>
        </div>
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-sh-company">Company</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-company" name="company" type="text" placeholder="Company" value="{{ customer.default_address.company | escape }}" autocomplete="organization" data-acct-field></div>
        </div>
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-sh-a1">Address Line 1*</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-a1" name="address1" type="text" value="{{ customer.default_address.address1 | escape }}" required autocomplete="address-line1" data-acct-field></div>
        </div>
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-sh-a2">Address Line 2</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-a2" name="address2" type="text" value="{{ customer.default_address.address2 | escape }}" autocomplete="address-line2" data-acct-field></div>
        </div>
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-sh-suburb">Suburb*</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-sh-suburb" name="suburb" type="text" value="{{ customer.default_address.city | escape }}" required autocomplete="address-level2" data-acct-field></div>
        </div>
        <div class="gb-acct-form__row">
          <div class="gb-acct-field">
            <label class="gb-acct-field__label" for="acct-sh-state">State*</label>
