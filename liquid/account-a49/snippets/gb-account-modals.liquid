{%- doc -%}
  Account modal panels. Opened by account.js via [data-acct-modal-panel]. Copy
  of the frontend design HTML with SVG icons intact. Real backend wiring for
  Appstle CRUD / address save / discount apply comes in later iterations.
{%- enddoc -%}

{%- comment -%} Reusable close cross SVG for modal headers {%- endcomment -%}

{%- comment -%} Edit subscription name {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="edit-name" role="dialog" aria-modal="true" aria-labelledby="acct-modal-edit-name" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-edit-name">Edit name</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-modal__fields">
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-f-name">Name</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input" id="acct-f-name" type="text" value="My Subscription" data-acct-field></div>
        </div>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close disabled>Save</button>
    </div>
  </div>
</div>

{%- comment -%} Edit renewal date (inline calendar) {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="edit-date" role="dialog" aria-modal="true" aria-labelledby="acct-modal-edit-date" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-edit-date">Edit renewal date</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-modal__fields">
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-f-date">Next renewal date</label>
          <div class="gb-acct-field__control"><input class="gb-acct-field__input gb-acct-field__input--icon flatpickr-input" id="acct-f-date" type="text" value="19/07/2026" data-acct-field><svg class="gb-acct-field__icon" xmlns="http://www.w3.org/2000/svg" viewBox="336 397 20 20" fill="none" aria-hidden="true"><path d="M353.5 405.335H338.5M349.333 398.668V402.001M342.667 398.668V402.001M342.5 415.335H349.5C350.9 415.335 351.6 415.335 352.135 415.062C352.605 414.822 352.988 414.44 353.228 413.97C353.5 413.435 353.5 412.735 353.5 411.335V404.335C353.5 402.935 353.5 402.234 353.228 401.7C352.988 401.229 352.605 400.847 352.135 400.607C351.6 400.335 350.9 400.335 349.5 400.335H342.5C341.1 400.335 340.4 400.335 339.865 400.607C339.395 400.847 339.012 401.229 338.772 401.7C338.5 402.234 338.5 402.935 338.5 404.335V411.335C338.5 412.735 338.5 413.435 338.772 413.97C339.012 414.44 339.395 414.822 339.865 415.062C340.4 415.335 341.1 415.335 342.5 415.335Z" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <div class="gb-acct-cal gb-acct-cal--field" data-acct-cal data-acct-cal-for="acct-f-date">{%- render 'gb-account-flatpickr-cal' -%}</div>
        </div>
        <p class="gb-acct-modal__hint">Your next subscription order will be charged and processed on this date</p>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close disabled>Save</button>
    </div>
  </div>
</div>

{%- comment -%} Edit frequency {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="edit-frequency" role="dialog" aria-modal="true" aria-labelledby="acct-modal-edit-frequency" aria-hidden="true" hidden data-acct-watched="1">
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-edit-frequency">Edit frequency</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-modal__fields">
        <div class="gb-acct-field">
          <label class="gb-acct-field__label" for="acct-f-freq">Frequency</label>
          <div class="gb-acct-field__control"><select class="gb-acct-field__input" id="acct-f-freq" data-acct-field data-select><option>Ships every 2 weeks</option><option selected>Ships every 4 weeks</option><option>Ships every 6 weeks</option></select></div>
        </div>
        <p class="gb-acct-modal__hint">Your recurring renewal day of the week is <b>2026-07-19</b><br>Please allow 2-5 working days for your order to be with you</p>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close disabled>Save</button>
    </div>
  </div>
</div>

{%- comment -%} Edit payment method — sends magic-link email {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="edit-payment" role="dialog" aria-modal="true" aria-labelledby="acct-modal-edit-payment" aria-hidden="true" hidden>
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-edit-payment">Payment details</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <p class="gb-acct-modal__copy">We will email you a link to change your payment method. It might take a few minutes to arrive, try checking your spam folder if you can't find it.</p>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close>Update payment method</button>
    </div>
  </div>
</div>

{%- comment -%} Skip next order {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="skip-next" role="dialog" aria-modal="true" aria-labelledby="acct-modal-skip-next" aria-hidden="true" hidden>
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-skip-next">Skip next order</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <p class="gb-acct-modal__copy">Are you sure you want to skip the next order? Your next order date will be changed to <strong>17 July, 2026</strong></p>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close>Skip next order</button>
    </div>
  </div>
</div>

{%- comment -%} I need it now — expedite {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="need-now" role="dialog" aria-modal="true" aria-labelledby="acct-modal-need-now" aria-hidden="true" hidden>
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-need-now">I need it now</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <p class="gb-acct-modal__copy">Your order will be placed and charged now. If you would like to make changes to your subscription do so before continuing to payment.</p>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
      <button class="gb-acct-modal__save" type="button" data-acct-save data-acct-modal-close>Get it to me now</button>
    </div>
  </div>
</div>

{%- comment -%} Discount code — empty state {%- endcomment -%}
<div class="gb-acct-modal" data-acct-modal-panel="discount-add" data-acct-discount-state="empty" role="dialog" aria-modal="true" aria-labelledby="acct-modal-discount-add" aria-hidden="true" hidden>
  <div class="gb-acct-modal__backdrop" data-acct-modal-close></div>
  <div class="gb-acct-modal__panel" tabindex="-1">
    <div class="gb-acct-modal__head">
      <h2 class="gb-acct-modal__title" id="acct-modal-discount-add">Add a discount code</h2>
      <button class="gb-acct-modal__close" type="button" data-acct-modal-close aria-label="Close"><svg class="gb-acct-modal__cross" xmlns="http://www.w3.org/2000/svg" viewBox="346 317 24 24" fill="none" aria-hidden="true"><path d="M363 324L353 334M353 324L363 334" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="gb-acct-modal__body" data-lenis-prevent>
      <div class="gb-acct-discount">
        <div class="gb-acct-discount__field">
          <label class="gb-acct-field__label" for="acct-f-code">Discount code</label>
          <div class="gb-acct-discount__row">
            <input class="gb-acct-discount__input" id="acct-f-code" type="text" placeholder="Discount Code" value="" data-acct-discount-input>
            <button class="gb-acct-discount__apply" type="button" data-acct-apply disabled>Apply</button>
          </div>
        </div>
        <div class="gb-acct-discount__result" hidden>
          <div class="gb-acct-chip">
            <p></p>
            <button class="gb-acct-chip__remove" type="button" data-acct-chip-remove aria-label="Remove discount"><svg xmlns="http://www.w3.org/2000/svg" viewBox="337 447 16 16" fill="none" aria-hidden="true"><path d="M343 449.129H347M339 451.129H351M349.667 451.129L349.199 458.142C349.129 459.194 349.094 459.72 348.867 460.119C348.667 460.47 348.365 460.752 348.001 460.929C347.588 461.129 347.061 461.129 346.006 461.129H343.994C342.939 461.129 342.412 461.129 341.999 460.929C341.635 460.752 341.333 460.47 341.133 460.119C340.906 459.72 340.871 459.194 340.801 458.142L340.333 451.129M343.667 454.129V457.462M346.333 454.129V457.462" stroke="currentColor" stroke-width="1.33333" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </div>
        </div>
      </div>
    </div>
    <div class="gb-acct-modal__foot">
      <button class="gb-acct-link" type="button" data-acct-modal-close>Cancel</button>
    </div>
  </div>
</div>

