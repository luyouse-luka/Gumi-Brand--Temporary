    function renderAddProductCard(product) {
      var wrap = document.createElement('div');
      wrap.innerHTML = addProdCardTplHtml;
      var card = wrap.firstElementChild;
      card.setAttribute('data-product-id', product.id);

      var thumb = card.querySelector('.gb-acct-prod__thumb');
      if (thumb && product.image) thumb.setAttribute('src', product.image);
      var name = card.querySelector('.gb-acct-prod__name');
      if (name) name.textContent = product.title;

      // Options — replace design's hardcoded selects with real options.
      // Design's template has 1 option; we replace with N based on product.options.
      var optsWrap = card.querySelector('.gb-acct-prod__opts');
      if (optsWrap) {
        optsWrap.innerHTML = '';
        (product.options || []).forEach(function (opt, i) {
          if (opt.values.length <= 1 && opt.values[0] === 'Default Title') return;
          var wrap2 = document.createElement('div');
          wrap2.className = 'gb-acct-prod__opt';
          var label = document.createElement('span');
          label.className = 'gb-acct-prod__opt-label';
          label.textContent = opt.name;
          var control = document.createElement('div');
          control.className = 'gb-acct-field__control gb-acct-prod__control';
          var select = document.createElement('select');
          select.className = 'gb-acct-field__input gb-acct-prod__select';
          select.setAttribute('data-acct-field', '');
          select.setAttribute('data-select', '');
          select.setAttribute('data-option-index', i);
          opt.values.forEach(function (v, j) {
            var o = document.createElement('option');
            o.value = v;
            o.textContent = v;
            if (j === 0) o.selected = true;
            select.appendChild(o);
          });
          control.appendChild(select);
          wrap2.appendChild(label);
          wrap2.appendChild(control);
          optsWrap.appendChild(wrap2);
        });
      }

      var firstAvailable = (product.variants || []).find(function (v) { var stock = stockForVariant(v.id); return !stock || stock.available; });
      if (firstAvailable) card.querySelectorAll('.gb-acct-prod__select').forEach(function (select, i) { select.value = firstAvailable['option' + (i + 1)]; });
      updateCardPrice(card, product);
      return card;
    }

    // Read all option <select>s in a card, resolve the matching variant, and
    // update the price display. Called on init and on any select change.
    function updateCardPrice(card, product) {
      var chosen = Array.prototype.map.call(
        card.querySelectorAll('.gb-acct-prod__select'),
        function (s) { return s.value; }
      );
      var v = findVariant(product, chosen);
      card.setAttribute('data-variant-id', v ? v.id : '');
      var stock = v && stockForVariant(v.id);
      var available = !!v && (!stock || stock.available !== false);
      card.setAttribute('data-acct-stock-available', String(available));
      card.classList.toggle('gb-acct-prod--oos', !available);
      var stockNote = card.querySelector('[data-acct-stock-note]');
      if (!stockNote) { stockNote = document.createElement('p'); stockNote.setAttribute('data-acct-stock-note', ''); stockNote.className = 'gb-acct-prod__stock'; card.querySelector('.gb-acct-prod__info').appendChild(stockNote); }
      stockNote.hidden = available;
      stockNote.textContent = 'Out of stock';
      var modal = card.closest('[data-acct-modal-panel]');
      var quantity = card.querySelector('[data-acct-qty-value]');
      if (quantity) {
        quantity.disabled = !available;
        if (stock && stock.maxQuantity !== null) quantity.max = stock.maxQuantity;
        else quantity.removeAttribute('max');
        if (!available && (!modal || modal.getAttribute('data-acct-modal-panel') !== 'edit-product')) quantity.value = 0;
      }
      card.querySelectorAll('[data-acct-qty]').forEach(function (button) {
        var qty = Number(quantity && quantity.value || 0);
        button.disabled = !available || (button.getAttribute('data-acct-qty') === 'down' ? qty <= Number(quantity && quantity.min || 0) : stock && stock.maxQuantity !== null && qty >= stock.maxQuantity);
      });
      card.querySelectorAll('.gb-acct-prod__select').forEach(function (select) {
        var index = Number(select.getAttribute('data-option-index')) + 1;
        Array.prototype.forEach.call(select.options, function (option) {
          var hasStock = (product.variants || []).some(function (variant) { var state = stockForVariant(variant.id); return variant['option' + index] === option.value && (!state || state.available); });
          option.disabled = !hasStock;
          option.textContent = option.value + (hasStock ? '' : ' — Out of stock');
        });
      });
      var now = card.querySelector('.gb-acct-prod__now');
      var was = card.querySelector('.gb-acct-prod__was');
      if (card.__gbSubscriptionLine) {
        var line = card.__gbSubscriptionLine;
        if (v && String(idOf(line.variantId)) === String(v.id)) {
          // Use the same actual contract price/discounts as the subscription row.
          var row = renderProductRow(line);
          var actualNow = row.querySelector('.gb-acct-product__now');
          var actualWas = row.querySelector('.gb-acct-product__was');
          if (now) now.textContent = actualNow ? actualNow.textContent : '';
          if (was) {
            var quantity = Math.max(1, Number(line.quantity) || 1);
            var actualAmount = line.lineDiscountedPrice ? Number(line.lineDiscountedPrice.amount) / quantity : Number(line.currentPrice && line.currentPrice.amount);
            var catalogOriginal = Number(v.compare_at_price);
            var showCatalogOriginal = isFinite(actualAmount) && catalogOriginal > Math.round(actualAmount * 100);
            was.textContent = showCatalogOriginal ? moneyPrice(catalogOriginal) : actualWas ? actualWas.textContent : '';
            was.style.display = showCatalogOriginal || actualWas ? '' : 'none';
          }
          return;
        }
        var contract = card.__gbSubscriptionContract;
        var policy = contract.deliveryPolicy || contract.billingPolicy;
        var frequency = planFrequencyKey(frequencyLabel(policy));
        var plan = (product.selling_plans || []).find(function (item) { return planFrequencyKey(item.name) === frequency; });
        var planId = plan && plan.id || line.sellingPlanId || policy && policy.sellingPlanId;
        var allocation = v && (v.selling_plan_allocations || []).find(function (item) { return String(item.selling_plan_id) === String(idOf(planId)); });
        if (now) now.textContent = allocation ? moneyPrice(allocation.price) : 'Price confirmed after saving';
        if (was) {
          var original = v && v.compare_at_price || allocation && allocation.compare_at_price;
          was.textContent = original ? moneyPrice(original) : '';
          was.style.display = allocation && Number(original) > Number(allocation.price) ? '' : 'none';
        }
        return;
      }
      if (now) now.textContent = v ? moneyPrice(v.price) : '';
      if (was) {
        if (v && v.compare_at_price && Number(v.compare_at_price) > Number(v.price)) {
          was.textContent = moneyPrice(v.compare_at_price);
          was.style.display = '';
        } else {
          was.style.display = 'none';
        }
      }
    }

    // Qty +/- click handler for any product card in add/edit product modals.
    // The CTA sync differs between modes: add uses total==0 to disable;
    // edit compares to original variant/qty and toggles label.
    function attachQtyControls(panel) {
      panel._acctQtyOwned = true;
      var name = panel.getAttribute('data-acct-modal-panel');
      var syncCta = name === 'edit-product' ? syncEditCta : syncAddCta;
      panel.querySelectorAll('.gb-acct-prod').forEach(function (card) {
        var qtyEl = card.querySelector('[data-acct-qty-value]');
        var minus = card.querySelector('[data-acct-qty="down"]');
        var plus = card.querySelector('[data-acct-qty="up"]');
        var min = Number(card.getAttribute('data-acct-qty-min') || '0');
        qtyEl.min = min;
        function refresh() {
          var v = Number(qtyEl.value || '0');
          var available = card.getAttribute('data-acct-stock-available') !== 'false';
          qtyEl.disabled = !available;
          if (minus) minus.disabled = !available || v <= min;
          if (plus) plus.disabled = !available || (qtyEl.hasAttribute('max') && v >= Number(qtyEl.max));
        }
        if (!qtyEl.__bound) {
          qtyEl.__bound = true;
          qtyEl.addEventListener('input', function () {
            refresh();
            syncCta(panel);
          });
          qtyEl.addEventListener('change', function () {
            qtyEl.value = Math.min(qtyEl.hasAttribute('max') ? Number(qtyEl.max) : Infinity, Math.max(min, Math.floor(Number(qtyEl.value) || min)));
            refresh();
            syncCta(panel);
          });
        }
        if (minus && !minus.__bound) {
          minus.__bound = true;
          minus.addEventListener('click', function () {
            var v = Math.max(min, Number(qtyEl.value || '0') - 1);
            qtyEl.value = v;
            refresh();
            syncCta(panel);
          });
        }
        if (plus && !plus.__bound) {
          plus.__bound = true;
          plus.addEventListener('click', function () {
            var v = Math.min(qtyEl.hasAttribute('max') ? Number(qtyEl.max) : Infinity, Number(qtyEl.value || '0') + 1);
            qtyEl.value = v;
            refresh();
            syncCta(panel);
          });
        }
        refresh();
      });
    }

    function syncAddCta(panel) {
      var cta = panel.querySelector('[data-acct-save]');
      if (!cta) return;
      var total = 0;
      var valid = true;
      panel.querySelectorAll('[data-acct-qty-value]').forEach(function (el) {
        valid = valid && el.value !== '' && el.checkValidity();
        var card = el.closest('.gb-acct-prod');
        var qty = Number(el.value || '0');
        if (qty > 0 && card && card.getAttribute('data-acct-stock-available') === 'false') valid = false;
        total += qty;
      });
      cta.disabled = panel.hasAttribute('data-acct-stock-loading') || !valid || total === 0;
    }

    // edit-product Save button toggles label to "Remove this product" when
    // qty drops to zero (design attribute data-acct-label-zero).
    function syncEditCta(panel) {
      var cta = panel.querySelector('[data-acct-save]');
      if (!cta) return;
      var qtyEl = panel.querySelector('[data-acct-qty-value]');
      var qty = Number((qtyEl && qtyEl.value) || '0');
      var productError = panel.querySelector('[data-acct-product-error]');
      if (productError && qty > 0) { productError.hidden = true; productError.style.display = 'none'; }
      var valid = qtyEl && qtyEl.value !== '' && qtyEl.checkValidity();
      var origVariant = panel.getAttribute('data-acct-line-orig-variant-id');
      var origQty = Number(panel.getAttribute('data-acct-line-orig-qty') || '0');
      var card = panel.querySelector('.gb-acct-prod');
      var newVariant = card && card.getAttribute('data-variant-id');
      var changed = (qty !== origQty) || (newVariant && String(newVariant) !== String(origVariant));
      cta.disabled = panel.hasAttribute('data-acct-stock-loading') || !valid || !changed || (qty > 0 && card && card.getAttribute('data-acct-stock-available') === 'false');
      var labelZero = cta.getAttribute('data-acct-label-zero');
      var labelDefault = cta.getAttribute('data-acct-label-default') || 'Save';
      cta.textContent = (qty === 0 && labelZero) ? labelZero : labelDefault;
    }

    // Subscription name from customAttribute (fallback to design default).
    function subscriptionName(contract) {
      var attrs = (contract && contract.customAttributes) || [];
      var found = attrs.find && attrs.find(function (a) {
        return a && (a.key === '_subscription_name' || a.name === '_subscription_name');
      });
      var v = found && found.value;
      return (v && String(v).trim()) || 'My Subscription';
    }

    var skippedAttempts = Object.create(null);

    function rememberSkippedDate(subId, iso) {
      var date = String(iso || '').slice(0, 10);
      if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) return;
      var dates = skippedAttempts[String(subId)] || (skippedAttempts[String(subId)] = []);
      if (dates.indexOf(date) === -1) dates.push(date);
    }

    function loadSkippedOrders() {
      return api('/orders/past').then(function (res) {
        if (!res || !res.ok || !res.j || res.j.ok === false) return;
        skippedAttempts = Object.create(null);
        collectionItems(res.j.orders).forEach(function (attempt) {
          if (attempt && String(attempt.status || '').toUpperCase() === 'SKIPPED') rememberSkippedDate(idOf(attempt.contractId), attempt.billingDate);
        });
      }).catch(function (error) { console.warn('Could not load skipped order states', error); });
    }

    function activeSkippedDates(contract) {
      var today = localDateToISO(new Date());
      var next = String(contract.nextBillingDate || '').slice(0, 10);
      return (skippedAttempts && skippedAttempts[String(idOf(contract.id))] || []).filter(function (date) { return date >= today && date < next; }).sort();
    }

    var immediateOrderStates = Object.create(null);

    function immediateOrderPending(contract) {
      var state = contract && immediateOrderStates && immediateOrderStates[String(idOf(contract.id))];
      return state && (state.status === 'pending' || state.status === 'refreshing');
    }

    function applyImmediateOrderUi(root, contract) {
      if (!root) return;
      var state = immediateOrderStates && immediateOrderStates[String(idOf(contract.id))];
      var pending = !!immediateOrderPending(contract);
      root.setAttribute('aria-busy', String(pending));
      if (pending) root.setAttribute('data-acct-order-processing', '');
      else root.removeAttribute('data-acct-order-processing');
      root.querySelectorAll('button:not([data-acct-goto]), input, select, textarea').forEach(function (control) {
        if (pending) {
          if (!control.__gbOrderLock) control.__gbOrderLock = { disabled: control.disabled, aria: control.getAttribute('aria-disabled'), opacity: control.style.opacity, cursor: control.style.cursor };
          control.disabled = true;
          control.setAttribute('aria-disabled', 'true');
          control.style.opacity = '0.5';
          control.style.cursor = 'not-allowed';
        } else if (control.__gbOrderLock) {
          var original = control.__gbOrderLock;
          control.disabled = original.disabled;
          if (original.aria == null) control.removeAttribute('aria-disabled');
          else control.setAttribute('aria-disabled', original.aria);
          control.style.opacity = original.opacity;
          control.style.cursor = original.cursor;
          delete control.__gbOrderLock;
        }
      });
      var date = root.querySelector('.gb-acct-row--renewal .gb-acct-row__date, [data-acct-sub-renewal] .gb-acct-sub__meta-value');
      if (date) date.textContent = pending ? 'Updating…' : formatDate(subscriptionDisplayDate(contract));
      var note = root.querySelector('[data-acct-order-progress]');
      if (state) {
        if (!note) {
          note = document.createElement('p');
          note.className = 'gb-acct-row__note';
          note.setAttribute('data-acct-order-progress', '');
          note.setAttribute('role', 'status');
          note.setAttribute('aria-live', 'polite');
          if (date) date.parentNode.appendChild(note);
          else root.appendChild(note);
        }
        note.textContent = state.message;
      } else if (note) note.remove();
    }

    function updateImmediateOrderUi(subId) {
      var contract = contractCache[subId];
      if (!contract) return;
      var card = subsList.querySelector('[data-sub-id="' + subId + '"]');
      if (card) applyImmediateOrderUi(card, contract);
      if (detailRoot && String(detailRoot.getAttribute('data-sub-id')) === subId) applyImmediateOrderUi(detailRoot, contract);
    }

    function waitForImmediateOrder(panel, contract, response) {
      var subId = String(idOf(contract.id));
      var data = response.j && response.j.data || {};
      var attemptId = data.billingAttemptId || data.requestedBillingAttemptId || response.requestedBillingAttemptId;
      var state = { status: 'pending', attemptId: String(idOf(attemptId)), started: Date.now(), message: 'Your order is processing. Subscription changes will be available once payment is confirmed.' };
      immediateOrderStates[subId] = state;
      panel.querySelector('[data-acct-save]').__gbOrderAccepted = true;
      updateImmediateOrderUi(subId);
      function pause(ms) { return new Promise(function (resolve) { window.setTimeout(resolve, ms); }); }
      function delay() { var elapsed = Date.now() - state.started; return elapsed < 120000 ? 4000 : elapsed < 300000 ? 10000 : 30000; }
      function message(text) { state.message = text; updateImmediateOrderUi(subId); }
      function refreshSubscription() {
        return api('/subscription/' + encodeURIComponent(subId)).then(function (result) {
          var updated = result && result.ok && result.j && result.j.ok !== false && result.j.subscription;
          return updated ? syncHolidayBillingDate(contract, updated) : null;
        }).then(function (updated) {
          if (updated) {
            var advanced = String(updated.nextBillingDate || '').slice(0, 10) !== String(contract.nextBillingDate || '').slice(0, 10);
            contractCache[subId] = updated;
            if (advanced) {
              state.status = 'success';
              state.message = 'Your order has been placed successfully.';
            }
            var card = subsList.querySelector('[data-sub-id="' + subId + '"]');
            if (card) card.replaceWith(renderCard(updated));
            if (String(currentSubParam()) === subId) renderDetail(updated);
            renderCurrentOrder(Object.keys(contractCache).map(function (id) { return contractCache[id]; }));
            if (advanced) return;
          }
          return pause(delay()).then(refreshSubscription);
        }).catch(function () { return pause(delay()).then(refreshSubscription); });
      }
      function poll() {
        return api('/orders/past').then(function (result) {
          if (result && result.ok && result.j && result.j.ok !== false) {
            var attempt = collectionItems(result.j.orders).find(function (item) {
              return item && String(idOf(item.contractId)) === subId &&
                (String(idOf(item.id)) === state.attemptId || String(idOf(item.billingAttemptId)) === state.attemptId);
            });
            var status = String(attempt && attempt.status || '').toUpperCase();
            if (status === 'SUCCESS') {
              state.status = 'refreshing';
              message('Payment successful. Updating your next renewal date…');
              return refreshSubscription();
            }
            if (['FAILURE', 'SHOPIFY_EXCEPTION', 'CONTRACT_CANCELLED', 'CONTRACT_ENDED', 'CONTRACT_PAUSED'].indexOf(status) !== -1) {
              state.status = 'failed';
              message(attempt.billingAttemptResponseMessage || 'Payment could not be completed. Check your payment method before trying again.');
              return;
            }
            if (status === 'SECURITY_CHALLENGE') message('Your bank requires payment verification. Please check the payment verification instructions sent to you.');
          }
          return pause(delay()).then(poll);
        }).catch(function () { return pause(delay()).then(poll); });
      }
      // Continue independently after the modal closes; never resubmit the charge.
      pause(2000).then(poll).catch(function (error) { console.warn('Immediate order status check failed', error); });
    }

    // Prefill handlers ------------------------------------------------------
    var skipConfirmation = null;

    var prefill = {
      'shipping-current': function (panel, contract) {
        var address = contract.deliveryMethod && contract.deliveryMethod.address || {};
        var group = panel.querySelector('.gb-acct-addr__group');
        if (!group) return;
        group.textContent = '';
        var lines = [[address.firstName, address.lastName].filter(Boolean).join(' '), address.company, address.address1, address.address2, [address.city, address.province || address.provinceCode, address.country || address.countryCode].filter(Boolean).join(', '), address.zip, address.phone];
        lines.filter(Boolean).forEach(function (text, index) {
          var line = document.createElement('span');
          line.className = 'gb-acct-addr__line' + (index === 0 ? ' gb-acct-addr__line--name' : '');
          line.textContent = text;
          group.appendChild(line);
        });
      },
      'shipping-form': function (panel, contract) {
        var address = contract.deliveryMethod && contract.deliveryMethod.address || {};
        var attributes = collectionItems(contract.customAttributes);
        var instructions = attributes.find(function (attr) { return (attr.key || attr.name) === 'Delivery Instructions'; });
        var values = {
          '#acct-sh-first': address.firstName,
          '#acct-sh-last': address.lastName,
          '#acct-sh-phone': String(address.phone || '').replace(/^\+61\s*/, ''),
          '#acct-sh-company': address.company,
          '#acct-sh-a1': address.address1,
          '#acct-sh-a2': address.address2,
          '#acct-sh-suburb': address.city,
          '#acct-sh-state': address.provinceCode,
          '#acct-sh-post': address.zip,
          '#acct-sh-note': instructions && instructions.value
        };
        Object.keys(values).forEach(function (selector) {
          var input = panel.querySelector(selector);
          if (!input) return;
          input.value = values[selector] || '';
          input.setCustomValidity('');
          input.dispatchEvent(new Event('input', { bubbles: true }));
          input.dispatchEvent(new Event('change', { bubbles: true }));
        });
        var error = panel.querySelector('[data-acct-discount-error]');
        if (error) error.remove();
      },
      'need-now': function (panel, contract) {
        var save = panel.querySelector('[data-acct-save]');
        save.__gbOrderAccepted = !!immediateOrderPending(contract);
        save.disabled = !!immediateOrderPending(contract);
        var error = panel.querySelector('[data-acct-discount-error]');
        if (error) error.remove();
      },
      'edit-payment': function (panel) {
        var save = panel.querySelector('[data-acct-save]');
        save.__gbEmailSent = false;
        save.disabled = false;
        save.textContent = 'Update payment method';
        var error = panel.querySelector('[data-acct-discount-error]');
        if (error) error.remove();
        var copy = panel.querySelector('.gb-acct-modal__copy');
        if (copy) { copy.removeAttribute('role'); copy.textContent = "We will email you a link to change your payment method. It might take a few minutes to arrive, try checking your spam folder if you can't find it."; }
        var close = panel.querySelector('.gb-acct-modal__foot .gb-acct-link');
        if (close) close.textContent = 'Cancel';
      },
      'edit-date': function (panel, contract) {
        panel.__gbUnskipDate = panel.__gbTrigger && panel.__gbTrigger.hasAttribute('data-acct-unskip') ? activeSkippedDates(contract)[0] || '' : '';
        panel.__gbRestored = false;
        var error = panel.querySelector('[data-acct-discount-error]');
        if (error) error.remove();
        var input = panel.querySelector('#acct-f-date');
        var date = panel.__gbUnskipDate || String(contract.nextBillingDate || '').slice(0, 10);
        var parts = date.split('-').map(Number);
        if (input && input._flatpickr && parts.length === 3) input._flatpickr.setDate(new Date(parts[0], parts[1] - 1, parts[2]), false);
        else setDateInput(input, date);
      },
      'edit-name': function (panel, contract) {
        var input = panel.querySelector('#acct-f-name');
        if (!input) return;
        var attrs = contract.customAttributes || [];
        var nameAttr = attrs.find && attrs.find(function (a) { return a && a.key === '_subscription_name'; });
        input.value = (nameAttr && nameAttr.value) || 'My Subscription';
      },
      'edit-frequency': function (panel, contract) {
        var select = panel.querySelector('#acct-f-freq');
        var hint = panel.querySelector('.gb-acct-modal__hint');
        if (hint) hint.innerHTML = 'Your next renewal date is <b>' + formatDate(contract.nextBillingDate) + '</b><br>Please allow 2-5 working days for your order to be with you';
        if (!select) return;
        var productPlans = sellingPlansForContract(contract, []);
        var planRequest = productPlans.length
          ? Promise.resolve(productPlans)
          : ensureSellingPlans().then(function (fallbackPlans) { return sellingPlansForContract(contract, fallbackPlans); });
        planRequest.then(function (flat) {
          if (!flat.length) return;

          var policy = contract.deliveryPolicy || contract.billingPolicy || {};
          var currentFrequency = planFrequencyKey(frequencyLabel(policy));
          var currentPlanId = policy.sellingPlanId || contract.sellingPlanId ||
            (contract.sellingPlan && contract.sellingPlan.id);
          if (!currentPlanId) {
            collectionItems(contract.lines).some(function (line) {
              if (line && line.sellingPlanId) { currentPlanId = line.sellingPlanId; return true; }
              return false;
            });
          }
          // The contract's delivery policy is what the account summary displays;
          // use it first when selecting the current plan, then fall back to ID.
          var selectedPlan = currentFrequency && flat.find(function (plan) {
            return planFrequencyKey(plan.name) === currentFrequency;
          });
          if (!selectedPlan && currentPlanId) {
            selectedPlan = flat.find(function (plan) {
              return String(idOf(plan.id)) === String(idOf(currentPlanId));
            });
          }

          select.innerHTML = '';
          flat.forEach(function (plan) {
            var option = document.createElement('option');
            option.value = idOf(plan.id);
            var frequency = planFrequencyKey(plan.name);
            if (frequency) {
              var frequencyParts = frequency.split(' ');
              var count = Number(frequencyParts[0]);
              var unit = frequencyParts[1];
              option.textContent = 'Ships every ' + count + ' ' + unit + (count === 1 ? '' : 's');
            } else {
              option.textContent = plan.name || 'Subscription frequency';
            }
            if (selectedPlan && String(idOf(plan.id)) === String(idOf(selectedPlan.id))) option.selected = true;
            select.appendChild(option);
          });

          // main.js builds a custom select from the initial markup, so keep its
          // visible option list in lockstep with the updated native select.
          var customSelect = select.closest('.gb-select');
          var customList = customSelect && customSelect.querySelector('.gb-select__list');
