    function skipUpcomingOrders(panel, contract) {
        var picked = panel.querySelector('input[name="acct-skip-count"]:checked');
        var count = panel.getAttribute('data-acct-modal-panel') === 'skip-next' ? 1 : picked && picked.value === 'skip-2' ? 2 : 1;
        if (activeSkippedDates(contract).length) return Promise.resolve({ ok: false, j: { error: 'Your next order has already been skipped. Edit your renewal date to change this.' } });
        var subId = idOf(contract.id);
        var completed = 0;
        function failed(result) {
          var detail = result && result.j && (result.j.error || result.j.message);
          var text = typeof detail === 'string' ? detail : detail && (detail.detail || detail.message || detail.title);
          return { ok: false, j: { error: (completed ? completed + (completed === 1 ? ' order was skipped. ' : ' orders were skipped. ') : '') + (text || 'We couldn’t skip your upcoming order. Please try again.') } };
        }
        function readUpdated(previous, tries) {
          return api('/subscription/' + encodeURIComponent(subId)).then(function (res) {
            var updated = res && res.ok && res.j && res.j.ok !== false && res.j.subscription;
            if (updated && updated.nextBillingDate && String(updated.nextBillingDate).slice(0, 10) !== String(previous.nextBillingDate || '').slice(0, 10)) return updated;
            if (tries > 0) return new Promise(function (resolve) { window.setTimeout(resolve, 750); }).then(function () { return readUpdated(previous, tries - 1); });
            throw new Error('The skipped order was accepted, but the updated renewal date is not available yet. Please refresh before trying again.');
          });
        }
        function skipOne(current) {
          return api('/skip-next', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId }),
          }).then(function (res) {
            if (!res || !res.ok || !res.j || res.j.ok === false) return failed(res);
            completed++;
            rememberSkippedDate(subId, current.nextBillingDate);
            return readUpdated(current, 6).then(function (updated) {
              contractCache[subId] = updated;
              if (completed < count) return skipOne(updated);
              return { ok: true, j: { ok: true }, skippedCount: completed, updatedContract: updated };
            });
          });
        }
        return skipOne(contract).catch(function (error) { return failed({ j: { error: error.message } }); });
    }

    // Submit handlers -------------------------------------------------------
    var submit = {
      'edit-date': function (panel, contract) {
        var iso = readDateInput(panel.querySelector('#acct-f-date'));
        if (!iso) return Promise.reject(new Error('Please select a valid renewal date.'));
        var subId = idOf(contract.id);
        function updateDate() {
          return api('/update-date', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId, next_billing_date: iso }),
          }).then(function (res) {
            if (panel.__gbRestored && (!res || !res.ok || res.j && res.j.ok === false)) {
              showRestoredState();
              return { ok: false, j: { error: 'The order was restored, but its renewal date could not be updated. Please save the date again.' } };
            }
            return res;
          });
        }
        function showRestoredState() {
          skippedAttempts[String(subId)] = (skippedAttempts[String(subId)] || []).filter(function (date) { return date !== panel.__gbUnskipDate; });
        }
        if (!panel.__gbUnskipDate || panel.__gbRestored) return updateDate();
        return api('/orders/past').then(function (res) {
          if (!res || !res.ok || res.j && res.j.ok === false) return res;
          var attempt = collectionItems(res.j.orders).find(function (order) {
            return String(idOf(order.contractId)) === String(subId) && String(order.status || '').toUpperCase() === 'SKIPPED' && String(order.billingDate || '').slice(0, 10) === panel.__gbUnskipDate;
          });
          if (!attempt || !attempt.id) return { ok: false, j: { error: 'This skipped order is no longer available to restore. Please refresh the page.' } };
          return api('/unskip-order/' + encodeURIComponent(idOf(attempt.id)), {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId }),
          }).then(function (restored) {
            if (!restored || !restored.ok || restored.j && restored.j.ok === false) return restored;
            panel.__gbRestored = true;
            showRestoredState();
            return updateDate();
          });
        });
      },
      'edit-name': function (panel, contract) {
