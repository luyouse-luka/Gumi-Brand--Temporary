      'cancel-reason': function (panel, contract) {
        // Frontend routing (verified against live account.js):
        //   going-away   → jumps to cancel-holiday   (branch handles it)
        //   too-expensive → jumps to cancel-discount (branch handles it)
        //   others (5)   → CTA becomes "Cancel", frontend only closes the
        //                  modal. We call /update-status CANCELLED here.
        var picked = panel.querySelector('input[name="acct-cancel-reason"]:checked');
        var reason = picked ? picked.value : '';
        var subId = idOf(contract.id);
        // Always record the reason.
        var writeReason = api('/update-attributes', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            subscription_id: subId,
            attributes: [{ key: '_cancel_reason', value: reason }],
          }),
        });
        if (reason === 'going-away' || reason === 'too-expensive') return writeReason;
        return writeReason.then(function (res) {
          if (!res || !res.ok || res.j && res.j.ok === false) return res;
          return api('/update-status', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId, status: 'CANCELLED' }),
