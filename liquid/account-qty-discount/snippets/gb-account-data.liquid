      'skip-next': skipUpcomingOrders,
      'need-now': function (panel, contract) {
        var subId = String(idOf(contract.id));
        var pending = immediateOrderStates[subId];
        if (pending && pending.status === 'pending') {
          return Promise.resolve({ ok: false, j: { error: pending.message } });
        }
        return api('/orders/upcoming').then(function (res) {
          if (!res || !res.ok || !res.j || res.j.ok === false) return res;
          var attempts = collectionItems(res.j.orders).filter(function (attempt) {
            return attempt && String(idOf(attempt.contractId)) === subId &&
              String(attempt.status || '').toUpperCase() === 'QUEUED' && attempt.id != null;
          });
          attempts.sort(function (a, b) { return new Date(a.billingDate).getTime() - new Date(b.billingDate).getTime(); });
          if (!attempts.length) {
            return { ok: false, j: { error: 'There is no upcoming order available for this subscription. Refresh the page and try again.' } };
          }
          return api('/need-now', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId, billing_attempt_id: attempts[0].id }),
          }).then(function (result) {
