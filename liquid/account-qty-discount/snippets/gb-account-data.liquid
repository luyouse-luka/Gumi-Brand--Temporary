        // Render the single card, preselect current variant options.
        grid.innerHTML = '';
        var card = renderAddProductCard(product);
        card.__gbSubscriptionLine = collectionItems(contract.lines).find(function (line) { return String(idOf(line.id)) === String(idOf(lineId)); });
        card.__gbSubscriptionContract = contract;
        card.setAttribute('data-acct-qty-min', '0');
