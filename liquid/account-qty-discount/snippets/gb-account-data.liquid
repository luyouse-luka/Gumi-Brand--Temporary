      'cancel-holiday': function (panel, contract) {
        // Fake-pause per funkyfood pattern: skip upcoming + move billing to
        // resume date + record _resume_date attribute. Status stays ACTIVE.
        var hidden = panel.querySelector('[data-acct-cal-input]');
        var iso = readDateInput(hidden);
        if (!iso) return Promise.reject(new Error('Choose a resume date before pausing your subscription.'));
        var minDate = String(contract.nextBillingDate || '').slice(0, 10);
        if (!/^\d{4}-\d{2}-\d{2}$/.test(minDate)) {
          return Promise.reject(new Error('We couldn’t read your next payment date. Refresh the page and try again.'));
        }
        if (iso < minDate) {
          return Promise.reject(new Error('Choose a resume date on or after your next payment date: ' + toDDMMYYYY(minDate) + '.'));
        }
        var subId = idOf(contract.id);
        return api('/skip-next', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription_id: subId }),
        }).then(function (res) {
          if (!res || !res.ok || (res.j && res.j.ok === false)) return res;
          return api('/update-date', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId, next_billing_date: iso }),
          });
        }).then(function (res) {
          if (!res || !res.ok || (res.j && res.j.ok === false)) return res;
          return api('/update-attributes', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              subscription_id: subId,
              attributes: [
                { key: '_resume_date', value: iso },
