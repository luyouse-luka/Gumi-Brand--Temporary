    function toDDMMYYYY(iso) {
      if (!iso) return '';
      var d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      var dd = String(d.getDate()).padStart(2, '0');
      var mm = String(d.getMonth() + 1).padStart(2, '0');
      return dd + '/' + mm + '/' + d.getFullYear();
    }

    function parseDDMMYYYY(s) {
      var m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(String(s || '').trim());
      if (!m) return null;
      return m[3] + '-' + m[2] + '-' + m[1];  // YYYY-MM-DD
    }

    // Helpers used across modals -------------------------------------------

    function setDateInput(input, iso) {
      if (!input || !iso) return;
      input.value = toDDMMYYYY(iso);
      if (input._flatpickr) { try { input._flatpickr.setDate(iso, false); } catch (e) {} }
    }

    function localDateToISO(date) {
      var yyyy = date.getFullYear();
      var mm = String(date.getMonth() + 1).padStart(2, '0');
      var dd = String(date.getDate()).padStart(2, '0');
      return yyyy + '-' + mm + '-' + dd;
    }

    function readDateInput(input) {
      if (!input) return null;
      // flatpickr selectedDates are local calendar dates. Avoid toISOString(),
      // which converts local midnight to the previous UTC date in UTC+ zones.
      if (input._flatpickr && input._flatpickr.selectedDates && input._flatpickr.selectedDates[0]) {
        return localDateToISO(input._flatpickr.selectedDates[0]);
      }
      return parseDDMMYYYY(input.value);
    }

    function addInterval(iso, policy) {
      if (!iso || !policy) return iso;
      var d = new Date(iso);
      var step = policy.intervalCount || 1;
      var unit = String(policy.interval || 'WEEK').toUpperCase();
      if (unit === 'DAY') d.setDate(d.getDate() + step);
      else if (unit === 'WEEK') d.setDate(d.getDate() + step * 7);
      else if (unit === 'MONTH') d.setMonth(d.getMonth() + step);
      else if (unit === 'YEAR') d.setFullYear(d.getFullYear() + step);
      return d.toISOString().slice(0, 10);
    }

    function longDate(iso) {
      if (!iso) return '';
      var d = new Date(iso);
      if (isNaN(d.getTime())) return '';
      return d.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
    }

    // Selling plans cache (fetched once on first edit-frequency open).
    var sellingPlansCache = null;
    function ensureSellingPlans() {
      if (sellingPlansCache) return Promise.resolve(sellingPlansCache);
