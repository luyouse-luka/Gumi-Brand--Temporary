        // Pre-select each option to match the current variant.
        var current = (product.variants || []).find(function (v) { return String(v.id) === String(variantId); });
        if (current) {
          card.querySelectorAll('.gb-acct-prod__select').forEach(function (sel, i) {
            var key = 'option' + (i + 1);
            var val = current[key];
            if (val) sel.value = val;
          });
          updateCardPrice(card, product);
        }
        updateCardPrice(card, product);
        // Preset qty
        var qtyEl = card.querySelector('[data-acct-qty-value]');
        if (qtyEl) qtyEl.value = qty;

        // Wire selects to refresh price on change.
        card.querySelectorAll('.gb-acct-prod__select').forEach(function (sel) {
          if (sel.__bound) return; sel.__bound = true;
