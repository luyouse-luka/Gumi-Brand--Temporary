      'edit-product': function (panel, contract) {
        var subId = idOf(contract.id);
        var lineId = panel.getAttribute('data-acct-line-id');
        var origVariantId = panel.getAttribute('data-acct-line-orig-variant-id');
        var origQty = Number(panel.getAttribute('data-acct-line-orig-qty') || '0');
        var qtyEl = panel.querySelector('[data-acct-qty-value]');
        var qty = Number((qtyEl && qtyEl.value) || '0');
        var card = panel.querySelector('.gb-acct-prod');
        var newVariantId = card && card.getAttribute('data-variant-id');
        var variantChanged = newVariantId && String(newVariantId) !== String(origVariantId);

        // Case 1: qty dropped to zero → remove line entirely.
        if (qty === 0) {
          return api('/remove-line-item', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ subscription_id: subId, line_id: lineId }),
          });
        }
        // Case 2: variant swap → replace-variants-v3 (also handles qty change).
        if (variantChanged) {
          var sellingPlanId = contract.deliveryPolicy && contract.deliveryPolicy.sellingPlanId;
          return api('/replace-variants', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              subscription_id: subId,
              old_variants: [{ variant_id: origVariantId, quantity: origQty }],
              new_variants: [{ variant_id: newVariantId, quantity: qty, selling_plan_id: sellingPlanId }],
            }),
          });
        }
        // Case 3: only qty changed → update quantity in place.
        if (qty !== origQty) {
          return api('/update-line-item', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              subscription_id: subId,
              line_id: lineId,
              quantity: qty,
              variant_id: origVariantId,
            }),
          });
        }
        return Promise.resolve({ ok: true, j: { ok: true } });
      },
      'add-product': function (panel, contract) {
        var cards = panel.querySelectorAll('.gb-acct-prod');
        var subId = idOf(contract.id);
        var chain = Promise.resolve();
        cards.forEach(function (card) {
          var qty = Number((card.querySelector('[data-acct-qty-value]') || {}).value || '0');
          if (qty <= 0) return;
          var variantId = card.getAttribute('data-variant-id');
          if (!variantId) return;
          chain = chain.then(function (previous) {
            if (previous && (!previous.ok || previous.j && previous.j.ok === false)) return previous;
            if (card.getAttribute('data-acct-stock-available') === 'false') return { ok: false, j: { error: 'This product is out of stock. Please choose another option.' } };
            return api('/add-line-item', {
              method: 'POST', headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                subscription_id: subId,
                variant_id: variantId,
                quantity: qty,
              }),
            }).then(function (res) {
              if (res && res.ok && res.j && res.j.ok !== false) card.remove();
              return res;
            });
          });
        });
        return chain;
      },
      'cancel-offer-skip': skipUpcomingOrders,
    };

    submit['discount-applied'] = submit['discount-add'];

    // Chip remove (discount) — separate flow from save/apply/cta.
    document.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;
      var btn = e.target.closest('[data-acct-chip-remove]');
      if (!btn) return;
      if (immediateOrderPending(currentContract())) { e.preventDefault(); e.stopImmediatePropagation(); return; }
      var contract = currentContract();
      if (!contract) return;
      var panel = btn.closest('[data-acct-modal-panel]');
      var discountId = btn.getAttribute('data-acct-discount-id');
      if (!discountId) {
        showDiscountActionError(panel, null, 'We couldn’t identify this discount. Refresh the page and try again.');
        return;
      }
      btn.classList.add('is-loading');
      btn.setAttribute('data-acct-busy', '');
      api('/remove-discount', {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subscription_id: idOf(contract.id), discount_id: discountId }),
      }).then(function (res) {
        if (res && res.ok && res.j && res.j.ok !== false) {
          var error = panel && panel.querySelector('[data-acct-discount-error]');
          if (error) error.remove();
          return refetchAndRerender().then(function (updatedContract) {
            if (updatedContract && panel) {
              var refreshAppliedDiscounts = prefill['discount-applied'];
              if (refreshAppliedDiscounts) refreshAppliedDiscounts(panel, updatedContract);
            }
          });
        }
        console.warn('acct remove discount failed', res && res.j);
        showDiscountActionError(panel, res && res.j, 'We couldn’t remove this discount. Please try again.');
      }).catch(function (err) {
        console.error('acct remove discount', err);
        showDiscountActionError(panel, err, 'We couldn’t remove this discount. Please try again.');
      }).finally(function () {
        if (btn.isConnected) { btn.classList.remove('is-loading'); btn.removeAttribute('data-acct-busy'); }
      });
    }, true);

    // Only synchronize after actions started in this portal, never during boot/read-only refresh.
    function syncHolidayBillingDate(contract, latest) {
      var original = collectionItems(contract && contract.customAttributes).find(function (attr) {
        return (attr.key || attr.name) === '_resume_date' && /^\d{4}-\d{2}-\d{2}$/.test(String(attr.value || ''));
      });
      if (!original) return Promise.resolve(latest || null);
      var subId = idOf(contract.id);
      var read = latest ? Promise.resolve(latest) : api('/subscription/' + encodeURIComponent(subId)).then(function (res) {
        if (!res || !res.ok || !res.j || !res.j.subscription) throw new Error('The subscription changed, but its updated restart date could not be read. Please refresh before trying again.');
        return res.j.subscription;
      });
      return read.then(function (updated) {
        var nextDate = String(updated.nextBillingDate || '').slice(0, 10);
        if (!/^\d{4}-\d{2}-\d{2}$/.test(nextDate)) throw new Error('The updated billing date is unavailable. Please refresh before trying again.');
        var attrs = collectionItems(updated.customAttributes);
        var resume = attrs.find(function (attr) { return (attr.key || attr.name) === '_resume_date'; });
        if (!resume || !resume.value || String(resume.value) === nextDate) return updated;
        return api('/update-attributes', {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ subscription_id: subId, attributes: [{ key: '_resume_date', value: nextDate }] }),
        }).then(function (res) {
          if (!res || !res.ok || res.j && res.j.ok === false) throw new Error('Your billing date changed, but the restart date could not be synchronized. Please refresh before trying again.');
          updated.customAttributes = attrs.map(function (attr) { return (attr.key || attr.name) === '_resume_date' ? { key: '_resume_date', value: nextDate } : attr; });
          contractCache[subId] = updated;
          return updated;
        });
      });
    }

    // These portal actions can reschedule billing, including restoring a skipped order.
    ['edit-date', 'edit-frequency', 'skip-next', 'cancel-offer-skip', 'restart', 'edit-product', 'add-product'].forEach(function (name) {
      var originalHandler = submit[name];
      submit[name] = function (panel, contract) {
        return Promise.resolve().then(function () { return originalHandler(panel, contract); }).then(function (res) {
          // Edit Date can restore an order before a later date update fails; sync the actual resulting date too.
          var succeeded = res && res.ok && (!res.j || res.j.ok !== false);
          if (!succeeded && !(name === 'edit-date' && panel.__gbRestored)) return res;
          return syncHolidayBillingDate(contract, res && res.updatedContract).then(function (updated) {
            if (res && res.updatedContract && updated) res.updatedContract = updated;
            return res;
          });
        });
      };
    });

    // Refetch subscriptions and rerender the detail view for the current id.
    function refetchAndRerender() {
      return Promise.all([api('/subscriptions'), loadSkippedOrders()]).then(function (results) {
        var res = results[0];
        if (!res.ok || !res.j || !res.j.ok) return null;
        var list = res.j.subscriptions || [];
        list.forEach(function (c) { contractCache[idOf(c.id)] = c; });
        // Update card in place (cheapest: rebuild the whole list — still fast).
        renderList(list);
        renderCurrentOrder(list);
        var id = currentSubParam();
        if (id && contractCache[id]) {
          renderDetail(contractCache[id]);
          return contractCache[id];
        }
        return null;
      });
    }

    function confirmProductQuantity(contract, expected) {
      var attempts = 0;
      function read() {
        return api('/subscription/' + encodeURIComponent(idOf(contract.id)), { cache: 'no-store' }).then(function (res) {
          var updated = res && res.ok && res.j && res.j.ok !== false && res.j.subscription;
          if (!updated) throw new Error('The product update was submitted, but its saved quantity could not be read. Please refresh before trying again.');
          var lines = collectionItems(updated.lines);
          var confirmed = expected.every(function (item) {
            var line = lines.find(function (candidate) {
              return item.lineId
                ? String(idOf(candidate.id)) === item.lineId
                : String(idOf(candidate.variantId)) === item.variantId;
            });
            return item.quantity === 0 ? !line : !!line && Number(line.quantity) === item.quantity;
          });
          if (confirmed) return updated;
          if (++attempts >= 6) throw new Error('The product update was submitted, but the saved quantity has not been confirmed yet. Please refresh before trying again.');
          return new Promise(function (resolve) { window.setTimeout(resolve, 700); }).then(read);
        });
      }
      return read();
    }

    // Capture click on any modal trigger to prefill *before* it opens.
    // Also remember which trigger opened the modal so we can toggle its
    // loading state when the modal's save action fires.
    document.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;
      var trigger = e.target.closest('[data-acct-modal]');
      if (!trigger) return;
      var name = trigger.getAttribute('data-acct-modal');
      if (name === 'edit-product' && trigger.disabled) { e.preventDefault(); e.stopImmediatePropagation(); return; }
      if (name === 'skip-next' && (trigger.disabled || activeSkippedDates(currentContract() || {}).length)) {
        e.preventDefault(); e.stopImmediatePropagation(); return;
      }
      if (trigger.closest('.gb-acct-detail') && immediateOrderPending(currentContract())) {
        e.preventDefault(); e.stopImmediatePropagation(); return;
      }
      if (name === 'cancel-offer-skip') {
        var cancelContract = currentContract();
        if (trigger.disabled || (cancelContract && subscriptionUiState(cancelContract) === 'paused')) {
          e.preventDefault();
          e.stopImmediatePropagation();
          return;
        }
      }
      if (name === 'discount-applied' || name === 'discount-add') {
        var discountContract = currentContract();
        var discountStatus = discountContract && subscriptionUiState(discountContract);
        if (trigger.disabled || discountStatus === 'cancelled' || discountStatus === 'canceled') {
          e.preventDefault();
          e.stopImmediatePropagation();
          return;
        }
      }
      var panel = document.querySelector('[data-acct-modal-panel="' + name + '"]');
      if (panel) panel.__gbTrigger = trigger;
      var handler = prefill[name];
      if (!handler) return;
      var contract = currentContract();
      if (!contract) return;
      if (!panel) return;
      try { handler(panel, contract); } catch (err) { console.warn('prefill', name, err); }
    }, true);

    document.addEventListener('input', function (event) {
      if (event.target.closest('[data-acct-modal-panel="shipping-form"]') && event.target.setCustomValidity) event.target.setCustomValidity('');
    }, true);
    document.addEventListener('submit', function (event) {
      var panel = event.target.closest('[data-acct-modal-panel="shipping-form"]');
      if (!panel) return;
      event.preventDefault(); event.stopImmediatePropagation();
      var save = panel.querySelector('[data-acct-save]');
      if (save && !save.disabled && !save.hasAttribute('data-acct-busy')) save.click();
    }, true);

    // Capture click on any modal primary action ([data-acct-save],
    // [data-acct-apply], [data-acct-cta]) to POST *before* frontend closes
    // / switches modals.
    document.addEventListener('click', function (e) {
      if (!e.target || !e.target.closest) return;
