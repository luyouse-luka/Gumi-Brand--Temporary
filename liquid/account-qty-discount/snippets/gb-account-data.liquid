          if (isHoliday) {
            var resumeDate = readDateInput(panel.querySelector('[data-acct-cal-input]'));
            var attributes = collectionItems(contract.customAttributes).filter(function (attr) {
              return ['_resume_date', '_pause_reason'].indexOf(attr.key || attr.name) === -1;
            });
            attributes.push({ key: '_resume_date', value: resumeDate }, { key: '_pause_reason', value: 'going-away' });
            var pausedContract = Object.assign({}, contract, { customAttributes: attributes, nextBillingDate: resumeDate });
            contractCache[idOf(contract.id)] = pausedContract;
            renderList(Object.keys(contractCache).map(function (id) { return contractCache[id]; }));
            renderDetail(pausedContract);
            var close = panel.querySelector('.gb-acct-modal__close[data-acct-modal-close]');
            if (close) close.click();
          }
          if (isPayment) {
            save.__gbEmailSent = true;
            save.textContent = 'Email sent';
            var copy = panel.querySelector('.gb-acct-modal__copy');
            if (copy) { copy.setAttribute('role', 'status'); copy.textContent = 'A payment update email has been sent. Please check your inbox and spam folder, then follow the link to update your payment method.'; }
            var paymentClose = panel.querySelector('.gb-acct-modal__foot .gb-acct-link');
