            var optimisticContract = Object.assign({}, contract);
            var optimisticDiscounts = collectionItems(contract.discounts).slice();
            var alreadyPresent = activeDiscounts(contract).some(function (discount) {
              return String(discount.code || '').toLowerCase() === submittedDiscountCode.toLowerCase();
            });
            if (submittedDiscountCode && !alreadyPresent) optimisticDiscounts.push({ code: submittedDiscountCode });
            optimisticContract.discounts = optimisticDiscounts;
            var optimisticId = idOf(optimisticContract.id);
            contractCache[optimisticId] = optimisticContract;
            renderDetail(optimisticContract);
            var successPanel = document.querySelector('[data-acct-modal-panel="discount-applied"]');
            if (!successPanel) {
              console.error('acct discount applied but success panel is missing');
              return;
            }
            var appliedPrefill = prefill['discount-applied'];
            function syncAppliedDiscountResult() {
              var panelNow = document.querySelector('[data-acct-modal-panel="discount-applied"]');
              if (!panelNow) return;
              var latestContract = contractCache[optimisticId] || optimisticContract;
              if (appliedPrefill) appliedPrefill(panelNow, latestContract);
              var resultNow = panelNow.querySelector('.gb-acct-discount__result');
