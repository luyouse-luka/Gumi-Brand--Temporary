          body: JSON.stringify({ subscription_id: subId, address: address }),
        }).then(function (res) {
          if (!res || !res.ok || !res.j || res.j.ok === false) return res;
          savedAddress = res;
          if (instructions === String(existingInstructions && existingInstructions.value || '')) return res;
          return api('/update-attributes', {
