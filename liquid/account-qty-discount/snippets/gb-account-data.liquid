              '</div>' +
              '<div class="gb-acct-qty">' +
                '<button class="gb-acct-qty__btn gb-acct-qty__btn--down" type="button" data-acct-qty="down" aria-label="Decrease quantity">-</button>' +
                '<input class="gb-acct-qty__value" type="number" inputmode="numeric" min="0" step="1" value="' + qty + '" data-acct-qty-value aria-label="Quantity">' +
                '<button class="gb-acct-qty__btn gb-acct-qty__btn--up" type="button" data-acct-qty="up" aria-label="Increase quantity">+</button>' +
              '</div>' +
            '</div>';
          attachQtyControls(panel);
          syncEditCta(panel);
