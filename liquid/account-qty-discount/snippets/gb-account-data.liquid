      var isDiscount = name === 'discount-add' || name === 'discount-applied';
      var isHoliday = name === 'cancel-holiday';
      var isNeedNow = name === 'need-now';
      var isShipping = name === 'shipping-form';
      var isDate = name === 'edit-date' || name === 'edit-frequency' || name === 'restart';
      var isPayment = name === 'edit-payment';
      var isCancelSkip = name === 'cancel-offer-skip' || name === 'skip-next';
      var isProduct = name === 'add-product' || name === 'edit-product';
      var expectedProducts = [];
      if (isProduct) {
        panel.querySelectorAll('.gb-acct-prod').forEach(function (card) {
          var quantity = Number((card.querySelector('[data-acct-qty-value]') || {}).value || '0');
          if (name === 'add-product' && quantity <= 0) return;
          var originalVariant = String(idOf(panel.getAttribute('data-acct-line-orig-variant-id') || ''));
          var variant = String(idOf(card.getAttribute('data-variant-id') || originalVariant));
          expectedProducts.push({
            lineId: name === 'edit-product' && (quantity === 0 || variant === originalVariant)
              ? String(idOf(panel.getAttribute('data-acct-line-id'))) : null,
            variantId: variant,
            quantity: quantity
          });
        });
      }
      var selectedCancelReason = panel.querySelector('input[name="acct-cancel-reason"]:checked');
      var isCancellation = name === 'cancel-reason' && selectedCancelReason && ['going-away', 'too-expensive'].indexOf(selectedCancelReason.value) === -1;
      if (isHoliday || isNeedNow || isCancelSkip || isDate || isPayment || isProduct || isCancellation) { e.preventDefault(); e.stopImmediatePropagation(); }
      var discountMutationSucceeded = false;
      var discountInput = isDiscount && panel.querySelector('[data-acct-discount-input]');
      var submittedDiscountCode = discountInput ? String(discountInput.value || '').trim() : '';
      var error = panel.querySelector('[data-acct-discount-error]');
      if (error) error.remove();
      if (isDiscount || isHoliday || isNeedNow || isShipping || isCancelSkip || isDate || isPayment || isProduct || isCancellation) { save.classList.add('is-loading'); save.setAttribute('data-acct-busy', ''); }
      if (isNeedNow || isPayment || isCancellation) save.disabled = true;
      function showDiscountError(result) {
        if (!isDiscount && !isHoliday && !isNeedNow && !isShipping && !isCancelSkip && !isDate && !isPayment && !isProduct && !isCancellation) return;
        var message = document.createElement('div');
        message.className = 'gb-acct-modal__alert';
        message.setAttribute('data-acct-discount-error', '');
        message.setAttribute('role', 'alert');
        message.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="17 249 20 20" fill="none" aria-hidden="true"><path d="M26.9964 267.366C31.5988 267.366 35.3298 263.635 35.3298 259.033C35.3298 254.43 31.5988 250.699 26.9964 250.699C22.394 250.699 18.6631 254.43 18.6631 259.033C18.6631 263.635 22.394 267.366 26.9964 267.366Z" fill="#DD655E"/><path d="M29.4971 256.535L24.4971 261.535M24.4971 256.535L29.4971 261.535" stroke="#ffffff" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg><p></p>';
        var detail = result && result.error;
        var text = typeof detail === 'string'
          ? detail
          : detail && (detail.message || detail.detail || detail.title || detail.error) || (result && (result.message || result.title)) || '';
        text = String(text).replace(/^UserGeneratedError:\s*/i, '').trim();
        if (text.length > 320) text = text.slice(0, 317) + '…';
        message.querySelector('p').textContent = text || (isCancellation ? 'We couldn’t cancel your subscription. Please try again.' : isProduct ? 'We couldn’t update this product. Please try again.' : isPayment ? 'We couldn’t send the payment update email. Please try again.' : isDate ? 'We couldn’t update your renewal date. Please try again.' : isHoliday ? 'We couldn’t pause your subscription. Please try again.' : isNeedNow ? 'We couldn’t place your order. Please try again.' : isShipping ? 'We couldn’t save your shipping address. Please try again.' : isCancelSkip ? 'We couldn’t skip your upcoming order. Please try again.' : 'We couldn’t apply this discount code. Check the code and try again.');
        var discount = panel.querySelector(isHoliday || isNeedNow || isShipping || isCancelSkip || isDate || isPayment || isProduct || isCancellation ? '.gb-acct-modal__body' : '.gb-acct-discount');
        if (discount) discount.appendChild(message);
      }
      // Discount UI waits for the API result; other actions keep their choreography.
      Promise.resolve()
        .then(function () { return handler(panel, contract); })
        .then(function (res) {
          if (!res || !res.ok || (res.j && res.j.ok === false)) {
            console.warn('acct save', name, 'failed', res && res.j);
            if (isDiscount || isHoliday || isNeedNow || isShipping || isCancelSkip || isDate || isPayment || isProduct || isCancellation) { showDiscountError(res && res.j); if (isCancelSkip || isProduct || isCancellation) return refetchAndRerender(); return; }
          }
          if (isCancellation) {
            var attempts = 0;
            function confirmCancelled() {
              return refetchAndRerender().then(function (updated) {
                var status = updated && String(updated.status || '').toLowerCase();
                if (status === 'cancelled' || status === 'canceled') {
                  var close = panel.querySelector('.gb-acct-modal__close[data-acct-modal-close]');
                  if (close) close.click();
                  return;
                }
                if (++attempts >= 6) throw new Error('Cancellation was submitted, but the updated status could not be confirmed yet. Please refresh to check your subscription.');
                return new Promise(function (resolve) { window.setTimeout(resolve, 700); }).then(confirmCancelled);
              });
            }
            return confirmCancelled();
          }
          if (isCancelSkip) {
            var updated = res.updatedContract;
            skipConfirmation = { subId: idOf(updated.id), count: res.skippedCount, nextBillingDate: updated.nextBillingDate };
            contractCache[idOf(updated.id)] = updated;
            var card = subsList.querySelector('[data-sub-id="' + idOf(updated.id) + '"]');
            if (card) card.replaceWith(renderCard(updated));
            if (String(currentSubParam()) === String(idOf(updated.id))) renderDetail(updated);
            renderCurrentOrder(Object.keys(contractCache).map(function (id) { return contractCache[id]; }));
            if (name === 'skip-next') {
              var close = panel.querySelector('.gb-acct-modal__close[data-acct-modal-close]');
              if (close) close.click();
              return;
            }
            var skippedTrigger = document.createElement('button');
            skippedTrigger.type = 'button';
            skippedTrigger.hidden = true;
            skippedTrigger.setAttribute('data-acct-modal', 'cancel-skipped');
            document.body.appendChild(skippedTrigger);
            skippedTrigger.click();
            skippedTrigger.remove();
            return;
          }
          if (isDiscount) {
            discountMutationSucceeded = true;
