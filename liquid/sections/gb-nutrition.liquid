{%- liquid
  assign s = section.settings
-%}
{%- if section.blocks.size > 0 -%}
  <style>
    {%- for i in (1..section.blocks.size) -%}
      #gb-nutrition-cards-{{ section.id }} > .gb-highlight-card:nth-of-type({{ i }}) { animation-delay: {{ i | times: 0.1 }}s; }
    {%- endfor -%}
  </style>
{%- endif -%}
<section class="gb-nutrition">
  <div class="gb-nutrition__top">
    {%- if s.title != blank -%}
      <h2 class="gb-nutrition__title wowo fadeInUp" data-line-reveal>{{ s.title }}</h2>
    {%- endif -%}
    <div class="gb-nutrition__cards" id="gb-nutrition-cards-{{ section.id }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'card' -%}
          {%- assign b = block.settings -%}
          <article class="gb-highlight-card wowo fadeInUp" {{ block.shopify_attributes }}>
            <div class="gb-highlight-card__media wowo fadeIn">
              {%- if b.image != blank -%}
                <picture>
                  <source type="image/webp"
                          srcset="{{ b.image | image_url: width: 640, format: 'webp' }} 640w, {{ b.image | image_url: width: 1280, format: 'webp' }} 1280w"
                          sizes="(min-width: 990px) 380px, 90vw">
                  <img src="{{ b.image | image_url: width: 640 }}"
                       srcset="{{ b.image | image_url: width: 640 }} 640w, {{ b.image | image_url: width: 1280 }} 1280w"
                       sizes="(min-width: 990px) 380px, 90vw"
                       width="{{ b.image.width }}" height="{{ b.image.height }}"
                       loading="lazy" decoding="async" alt="{{ b.image.alt | escape }}">
                </picture>
              {%- endif -%}
              <span class="gb-highlight-card__lip" aria-hidden="true"><svg aria-hidden="true" viewBox="0 0 573 94" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M525.811 0C551.873 0.00011568 573 21.0423 573 46.9993C573 72.9565 551.873 93.9999 525.811 94C509.027 94 494.292 85.2717 485.926 72.1253C477.56 85.2714 462.825 93.9998 446.042 94C429.258 94 414.522 85.2716 406.156 72.1253C397.79 85.2716 383.055 94 366.271 94C349.486 93.9998 334.749 85.2704 326.384 72.1223C318.018 85.27 303.283 93.9999 286.499 94C269.715 94 254.981 85.2722 246.615 72.1267C238.248 85.2719 223.515 94 206.732 94C189.948 94 175.213 85.2717 166.847 72.1253C158.481 85.2714 143.746 93.9998 126.963 94C110.177 94 95.4398 85.2706 87.0743 72.1223C78.7086 85.2701 63.9736 94 47.1888 94C21.1271 93.9999 0.000217693 72.9578 0 47.0007C0 21.0435 21.1269 0.000104648 47.1888 0C63.973 0 78.7084 8.72927 87.0743 21.8762C95.4399 8.72844 110.178 0 126.963 0C143.746 0.000173821 158.481 8.72767 166.847 21.8733C175.213 8.72733 189.949 0 206.732 0C223.514 5.06545e-05 238.248 8.72715 246.615 21.8718C254.981 8.72684 269.716 0 286.499 0C303.283 7.45002e-05 318.018 8.72906 326.384 21.8762C334.75 8.72869 349.486 0.000195701 366.271 0C383.054 0 397.79 8.72744 406.156 21.8733C414.522 8.72744 429.258 0 446.042 0C462.825 0.000201632 477.56 8.72767 485.926 21.8733C494.292 8.72735 509.028 0 525.811 0Z" fill="#005635"/></svg></span>
            </div>
            <div class="gb-highlight-card__body">
              <h3 class="gb-highlight-card__title">{{ b.title | escape }}</h3>
              <p class="gb-highlight-card__text">{%- render 'gb-rich-inline', html: b.text -%}</p>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if s.bears_image != blank or s.pack_image != blank -%}
    <div class="gb-nutrition__band">
      {%- if s.bears_image != blank -%}
        <div class="gb-nutrition__bears" aria-hidden="true">
          <picture>
            <source type="image/webp"
                    srcset="{{ s.bears_image | image_url: width: 832, format: 'webp' }}">
            <img class="gb-nutrition__bears-img"
                 src="{{ s.bears_image | image_url: width: 832 }}"
                 width="{{ s.bears_image.width }}" height="{{ s.bears_image.height }}"
                 loading="lazy" decoding="async" alt="">
          </picture>
        </div>
      {%- endif -%}
      {%- if s.pack_image != blank -%}
        <div class="gb-pack-band wowo fadeIn" aria-hidden="true" data-pack-band>
          {%- for i in (1..2) -%}
            <div class="gb-pack-band__row{% if forloop.last %} gb-pack-band__row--2{% endif %}">
              {%- for j in (1..2) -%}
                <picture>
                  <source type="image/webp" srcset="{{ s.pack_image | image_url: width: 776, format: 'webp' }}">
                  <img class="gb-pack-band__pack"
                       src="{{ s.pack_image | image_url: width: 776 }}"
                       width="{{ s.pack_image.width }}" height="{{ s.pack_image.height }}"
                       loading="lazy" alt="">
                </picture>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Gumi Nutrition",
  "settings": [
    { "type": "richtext", "id": "title", "label": "Title", "default": "<p>Nutrition that fits in your pocket</p>" },
    { "type": "image_picker", "id": "bears_image", "label": "Bears image (background)" },
    { "type": "image_picker", "id": "pack_image", "label": "Pack image (repeating band)" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Highlight card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Card body copy</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gumi Nutrition",
      "blocks": [
        { "type": "card", "settings": { "title": "Gym Bag Ready", "text": "<p>Toss a pack in with your pocket, no fridge, no mess, no excuses</p>" } },
        { "type": "card", "settings": { "title": "Tastes Like a Treat", "text": "<p>Because self care shouldn't feel like a chore</p>" } },
        { "type": "card", "settings": { "title": "One Handful a Day", "text": "<p>That's it. That's the whole routine</p>" } }
      ]
    }
  ]
}
{% endschema %}
