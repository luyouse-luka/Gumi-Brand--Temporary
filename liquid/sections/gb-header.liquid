<header class="gb-header" id="site-header">
  <div class="gb-header__bar">
    <button class="gb-header__toggle" type="button" aria-expanded="false" aria-controls="site-menu">
      <svg class="gb-icon-menu" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 12H21M3 6H21M3 18H21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg class="gb-icon-close" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 7L7 17M7 7L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="gb-header__toggle-label">Menu</span>
      <svg class="gb-icon-chevron" aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6 9L12 15L18 9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <a class="gb-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% render 'gb-logo', variant: 'sm' %}
    </a>

    <div class="gb-header__actions">
      <a class="gb-btn gb-btn--primary gb-header__cta" href="{{ routes.all_products_collection_url }}">Shop now</a>
      <div class="gb-header__icons">
        <a class="gb-header__icon" href="{{ routes.account_url }}" aria-label="Account" title="Account"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3 20.5C5.33579 18.0226 8.50702 16.5 12 16.5C15.493 16.5 18.6642 18.0226 21 20.5M16.5 8C16.5 10.4853 14.4853 12.5 12 12.5C9.51472 12.5 7.5 10.4853 7.5 8C7.5 5.51472 9.51472 3.5 12 3.5C14.4853 3.5 16.5 5.51472 16.5 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <script type="module" src="{{ 'cart-icon.js' | asset_url }}"></script>
        <cart-icon class="gb-header__icon-wrap{% unless cart == empty %} header-actions__cart-icon--has-cart{% endunless %}">
          <button class="gb-header__icon" type="button" on:click="#cart-drawer/toggle" aria-haspopup="dialog" aria-controls="cart-drawer" aria-label="Cart" title="Cart">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M16.0025 8C16.0025 9.06087 15.5811 10.0783 14.8309 10.8284C14.0808 11.5786 13.0634 12 12.0025 12C10.9417 12 9.92424 11.5786 9.17409 10.8284C8.42395 10.0783 8.00252 9.06087 8.00252 8M3.63574 7.40138L2.93574 15.8014C2.78536 17.6059 2.71017 18.5082 3.0152 19.2042C3.2832 19.8157 3.74755 20.3204 4.3347 20.6382C5.00299 21 5.90838 21 7.71916 21H16.2859C18.0967 21 19.002 21 19.6703 20.6382C20.2575 20.3204 20.7218 19.8157 20.9898 19.2042C21.2949 18.5082 21.2197 17.6059 21.0693 15.8014L20.3693 7.40138C20.2399 5.84875 20.1752 5.07243 19.8314 4.48486C19.5286 3.96744 19.0778 3.5526 18.537 3.29385C17.9229 3 17.1439 3 15.5859 3L8.41916 3C6.86114 3 6.08213 3 5.46803 3.29384C4.92726 3.5526 4.47642 3.96744 4.17364 4.48486C3.82982 5.07243 3.76512 5.84875 3.63574 7.40138Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {% render 'cart-bubble', limit: 100 %}
          </button>
        </cart-icon>
      </div>
    </div>
  </div>

  <div class="gb-header__panel" id="site-menu">
    <div class="gb-header__panel-clip">
    <div class="gb-header__panel-inner">
      <div class="gb-header__panel-bar">
        <button class="gb-header__panel-close" type="button" aria-label="Close menu">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M17 7L7 17M7 7L17 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <a class="gb-header__panel-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
          {% render 'gb-logo', variant: 'sm' %}
        </a>
      </div>
      <nav class="gb-header__nav" aria-label="Main">
        {%- comment -%}
          Two lists, one per breakpoint, on purpose. A Shopify link list cannot
          carry a class per entry, so the single list this replaced had to hide
          desktop-only entries with .gb-header__links-item--mobile -- which fixed
          the phone order as "every mobile entry, then every desktop entry".
          The board interleaves them (Shop, How Gumi Works, Science, Reviews,
          Learn more, Get in Touch), which that shape cannot express.
          Each list is now ordered by the merchant in the admin, and CSS shows
          exactly one of them. ⚠ Mobile menu must therefore carry the FULL phone
          menu, not just the entries desktop leaves out.
        {%- endcomment -%}
        <ul class="gb-header__links gb-header__links--desktop">
          {%- for link in section.settings.desktop_menu.links -%}
            <li><a class="gb-header__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
        <ul class="gb-header__links gb-header__links--mobile">
          {%- for link in section.settings.mobile_menu.links -%}
            {%- if link.links.size > 0 -%}
              <li data-collapsible>
                <button class="gb-header__link" type="button" aria-expanded="false">
                  {{ link.title | escape }}
                  <svg class="gb-header__link-chevron" aria-hidden="true" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 7.5L10 12.5L15 7.5" stroke="currentColor" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="gb-header__sublist">
                  <div>
                    {%- for sublink in link.links -%}
                      <a class="gb-header__sublink" href="{{ sublink.url }}">{{ sublink.title | escape }}</a>
                    {%- endfor -%}
                  </div>
                </div>
              </li>
            {%- else -%}
              <li><a class="gb-header__link" href="{{ link.url }}">{{ link.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        <a class="gb-btn gb-btn--lg" href="{{ routes.account_url }}">{{ section.settings.account_label | default: 'Manage Account' | escape }}</a>
      </nav>

      {%- if section.blocks.size > 0 -%}
        <div class="gb-header__cards">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'image_card' -%}
                <a class="gb-nav-card" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
                  <span class="gb-nav-card__title">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.image != blank -%}
                    <picture>
                      <source type="image/webp"
                              srcset="{{ block.settings.image | image_url: width: 523, format: 'webp' }} 523w, {{ block.settings.image | image_url: width: 1046, format: 'webp' }} 1046w"
                              sizes="(min-width: 990px) 260px, 40vw">
                      <img class="gb-nav-card__art"
                           src="{{ block.settings.image | image_url: width: 523 }}"
                           srcset="{{ block.settings.image | image_url: width: 523 }} 523w, {{ block.settings.image | image_url: width: 1046 }} 1046w"
                           sizes="(min-width: 990px) 260px, 40vw"
                           width="523" height="631" loading="lazy" decoding="async" alt="">
                    </picture>
                  {%- endif -%}
                  <span class="gb-nav-card__action"><svg aria-hidden="true" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.79519 11.4995H18.2114M11.5033 4.79146L18.2114 11.4995L11.5033 18.2076" stroke="currentColor" stroke-width="2.29991" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </a>
              {%- when 'text_card' -%}
                <a class="gb-nav-card" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
                  <span class="gb-nav-card__body">
                    <span class="gb-nav-card__tag">{{ block.settings.title | escape }}</span>
                    {%- if block.settings.text != blank -%}
                      <span class="gb-nav-card__text">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                  <span class="gb-nav-card__action"><svg aria-hidden="true" viewBox="0 0 23 23" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4.79519 11.4995H18.2114M11.5033 4.79146L18.2114 11.4995L11.5033 18.2076" stroke="currentColor" stroke-width="2.29991" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                </a>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Gumi Header",
  "tag": "section",
  "class": "gb-header-section",
  "max_blocks": 2,
  "settings": [
    { "type": "link_list", "id": "desktop_menu", "label": "Desktop menu" },
    { "type": "link_list", "id": "mobile_menu", "label": "Mobile menu (supports one level of nesting → sublists)" },
    { "type": "text", "id": "account_label", "label": "Account button label (mobile drawer)", "default": "Manage Account" }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Nav card — image",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "URL" },
        { "type": "image_picker", "id": "image", "label": "Image" }
      ]
    },
    {
      "type": "text_card",
      "name": "Nav card — text",
      "settings": [
        { "type": "text", "id": "title", "label": "Tag" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "url", "label": "URL" }
      ]
    }
  ],
  "presets": [
    { "name": "Gumi Header" }
  ]
}
{% endschema %}
