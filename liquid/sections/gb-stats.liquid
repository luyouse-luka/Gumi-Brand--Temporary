{%- liquid
  assign s = section.settings
  assign arc_id = 'gb-stats-arc-' | append: section.id
-%}
<section class="gb-stats">
  <div class="gb-stats__inner">
    <div class="gb-stats__head wowo fadeInUp">
      {%- if s.arc_text != blank -%}
        <svg class="gb-arc-text gb-stats__arc" viewBox="0 0 278 29" aria-hidden="true">
          <path id="{{ arc_id }}" d="M 34 51.591 A 118.5261 65.7047 0 0 1 244 51.591" fill="none"></path>
          <text text-anchor="middle"><textPath href="#{{ arc_id }}" startOffset="50%">{{ s.arc_text | escape }}</textPath></text>
        </svg>
      {%- endif -%}
      {%- if s.title != blank -%}
        <h2 class="gb-stats__title" data-line-reveal>{{ s.title }}</h2>
      {%- endif -%}
    </div>

    <div class="gb-stats__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          {%- assign b = block.settings -%}
          <div class="gb-stat gb-stat--{{ b.variant | default: 'ingredients' }}" {{ block.shopify_attributes }}>
            <p class="gb-stat__value" data-line-reveal><span class="gb-ink-halo" aria-hidden="true">{{ b.value }}{% if b.suffix != blank %}<span class="gb-stat__{% if b.suffix_style == 'unit' %}unit{% else %}plus{% endif %}">{{ b.suffix }}</span>{% endif %}</span>{{ b.value }}{% if b.suffix != blank %}<span class="gb-stat__{% if b.suffix_style == 'unit' %}unit{% else %}plus{% endif %}">{{ b.suffix }}</span>{% endif %}</p>
            <p class="gb-stat__label" data-line-reveal>{{ b.label }}</p>
            <p class="gb-stat__text" data-line-reveal>{{ b.text }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if s.bear_image != blank -%}
        <div class="gb-stats__bear">
          <div class="gb-stats__bear-art gb-float-art gb-float-art--d1">
            <picture>
              <source type="image/webp"
                      srcset="{{ s.bear_image | image_url: width: 1121, format: 'webp' }}">
              <img class="gb-stats__bear-img"
                   src="{{ s.bear_image | image_url: width: 1121 }}"
                   width="{{ s.bear_image.width }}" height="{{ s.bear_image.height }}"
                   loading="lazy" decoding="async" alt="">
            </picture>
          </div>
