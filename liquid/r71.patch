diff -ur baseline-r70/snippets/gb-scripts.liquid work-r71/snippets/gb-scripts.liquid
--- baseline-r70/snippets/gb-scripts.liquid	2026-09-04 13:14:42.353808130 +0000
+++ work-r71/snippets/gb-scripts.liquid	2026-09-04 13:43:58.069306487 +0000
@@ -2,6 +2,11 @@
   Gumi custom scripts. Rendered at the end of <body> from layout/theme.liquid.
   Swiper is loaded only where a carousel exists (see individual sections).
 {%- endcomment -%}
-<script src="{{ 'lenis.min.js' | asset_url }}"></script>
-<script src="{{ 'swiper-bundle.min.js' | asset_url }}"></script>
-<script src="{{ 'main.js' | asset_url }}"></script>
+{%- comment -%}
+  defer, not bare: these sit ~172KB into <body>, so parser-blocking tags
+  held main.js back ~3.6s and [data-line-reveal] text stayed visible that
+  whole time. defer keeps execution order and runs before DOMContentLoaded.
+{%- endcomment -%}
+<script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
+<script src="{{ 'swiper-bundle.min.js' | asset_url }}" defer></script>
+<script src="{{ 'main.js' | asset_url }}" defer></script>
