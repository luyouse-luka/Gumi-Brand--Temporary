{%- comment -%}
  Gumi custom stylesheet + head boot script. Rendered from layout/theme.liquid
  before {{ content_for_header }} so Horizon's own snippets keep their order.
{%- endcomment -%}
<script>(function(h){h.classList.add("js");function u(){window.gumi||h.classList.remove("js")}addEventListener("load",u);setTimeout(u,10000)})(document.documentElement)</script>
<link rel="stylesheet" href="{{ 'customstyle.css' | asset_url }}">
<noscript><style>.wowo{opacity:1 !important}</style></noscript>
