{%- comment -%}
  Gumi wordmark.
  Params:
    variant: 'sm' (124x32, green — for header) uses settings.logo
             'lg' (193x50, lime — for footer)   uses settings.logo_inverse
  If the corresponding theme setting is uploaded, renders <img>; otherwise
  falls back to the inline SVG.
{%- endcomment -%}
{%- assign variant = variant | default: 'sm' -%}
{%- if variant == 'lg' -%}
  {%- assign logo_img = settings.logo_inverse -%}
  {%- assign w = 193 -%}
  {%- assign h = 50 -%}
{%- else -%}
  {%- assign logo_img = settings.logo -%}
  {%- assign w = 124 -%}
  {%- assign h = 32 -%}
{%- endif -%}
{%- if logo_img != blank -%}
  {%- comment -%} `width: w | times: 2` multiplies the URL, not the width: image_url
  runs first and `times` on a string is 0, which shipped src="0" and a "0 2x"
  candidate. Double the number before it reaches the filter. {%- endcomment -%}
  {%- assign w2 = w | times: 2 -%}
  <img src="{{ logo_img | image_url: width: w2 }}"
       srcset="{{ logo_img | image_url: width: w }} 1x, {{ logo_img | image_url: width: w2 }} 2x"
       width="{{ w }}" height="{{ h }}"
       alt="{{ shop.name | escape }}" loading="eager" decoding="async">
